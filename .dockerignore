# Keep the backend image small and secret-free.
.git
.github
node_modules
frontend/node_modules
# frontend/dist is intentionally shipped: api.py serves the built SPA from it
# and mounts /assets from dist/assets. Excluding it makes the Space fall back to
# the raw dev index.html (which references /src/main.tsx and 404s).
frontend/.vite
dist
.vite
*.log
__pycache__
**/__pycache__
.pytest_cache
.venv
venv
env
.playwright-mcp

# NEVER ship secrets into the image — set them as platform env vars instead.
.env
config/.env
