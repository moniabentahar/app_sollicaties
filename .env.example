# Sollicitaties2026 — Environment Variables (template)
# Copy this file to config/.env and fill in your actual values

# Scrapling fetches the pages locally (free); Claude extracts the listings.
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Optional: override the extraction model (default: claude-haiku-4-5)
# SOLLICITATIES_EXTRACT_MODEL=claude-haiku-4-5

# ── Hosting the backend online (so Lovable can scan) ──────────────────
# Which fetcher the scan uses: http | dynamic | stealth.
#   http    = no browser, ~7 sites, runs anywhere
#   dynamic = Playwright Chromium, reliable in Docker (recommended when hosted)
#   stealth = camoufox stealth browser (local default, best anti-bot)
# SOLLICITATIES_FETCHER=dynamic
#
# Protect the (expensive) scan trigger with a shared secret. When set,
# /api/scan/run requires the X-Scan-Token header to match.
# SCAN_TOKEN=choose-a-long-random-string
#
# Comma-separated allowed origins for CORS, or "*".
# ALLOWED_ORIGINS=*

# ── Frontend build-time vars (set these in Lovable, NOT here) ─────────
# Point the hosted frontend at the hosted backend:
# VITE_API_BASE_URL=https://your-backend.onrender.com
# VITE_SCAN_TOKEN=same-value-as-SCAN_TOKEN
